# Copy this file to .env and set the values

# Backend URL (run the Node.js server before running the tests)
BASE_URL=http://localhost:3000

# MySQL in XAMPP (used for seeding the admin and cleaning up test data)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hopak

# Admin account the seed script creates for testing
ADMIN_USERNAME=qa_admin
ADMIN_PASSWORD=QaAdmin#2026

# Prefix for every test user, so cleanup only deletes test data
TEST_PREFIX=qa_
