{
  "name": "ho-phak-tests",
  "version": "1.0.0",
  "private": true,
  "description": "API, unit and E2E tests for Ho-Phak (Tester P1)",
  "scripts": {
    "seed": "node seed/seed-admin.js",
    "test": "jest --runInBand",
    "test:unit": "jest unit --runInBand",
    "test:api": "jest api --runInBand",
    "test:e2e": "jest e2e --runInBand",
    "report": "jest --runInBand --json --outputFile=reports/result.json"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "setupFiles": ["dotenv/config"]
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "supertest": "^7.0.0"
  }
}
